{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/checks-before-push.sh\"",
            "shell": "bash",
            "timeout": 300,
            "statusMessage": "Running CI checks before push"
          }
        ]
      }
    ]
  }
}
